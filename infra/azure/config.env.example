# Copy to config.env and fill in values before running scripts.
# Do not commit config.env (it may contain secrets).

# --- Azure account ---
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus
RESOURCE_GROUP=rg-temporal-prod
ENVIRONMENT=prod

# --- Naming prefix (short, lowercase, alphanumeric) ---
NAME_PREFIX=uncodie-temporal

# --- AKS ---
AKS_NODE_COUNT=3
AKS_NODE_VM_SIZE=Standard_D4s_v5
AKS_KUBERNETES_VERSION=

# --- PostgreSQL Flexible Server ---
POSTGRES_ADMIN_USER=temporaladmin
# Generate a strong password; store in Key Vault after first deploy
POSTGRES_ADMIN_PASSWORD=
POSTGRES_SKU=Standard_D2s_v3
POSTGRES_STORAGE_GB=128
POSTGRES_HA_ENABLED=true
POSTGRES_VERSION=16

# --- Temporal ---
TEMPORAL_NAMESPACE=default
TEMPORAL_HELM_RELEASE=temporal
TEMPORAL_K8S_NAMESPACE=temporal
# Internal LB hostname/IP is filled by wire-network script after deploy
TEMPORAL_SERVER_URL=

# --- Workers (Azure App Service from Git) ---
# GitHub repo in owner/name form
GITHUB_REPO_URL=https://github.com/YOUR_ORG/Workflows
GITHUB_BRANCH=main
# Leave empty to skip automated GitHub source deploy (configure in portal later)
GITHUB_TOKEN=
APP_SERVICE_SKU=P1v3
WORKER_DEFAULT_NAME=temporal-worker-default
WORKER_CRITICAL_NAME=temporal-worker-critical

# --- App secrets (mirrored from Render; set after Key Vault exists) ---
API_BASE_URL=https://backend.makinari.com
API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Self-hosted Temporal typically does not use TEMPORAL_API_KEY
TEMPORAL_TLS=false

# --- Public gRPC gateway (Vercel API clients) ---
# Hostname MUST contain "temporal.cloud" so the API client uses Cloud TLS + Bearer auth.
TEMPORAL_GATEWAY_HOSTNAME=temporal.cloud.makinari.com
TEMPORAL_GATEWAY_API_KEY=
TEMPORAL_GATEWAY_ACME_EMAIL=ops@makinari.com

# --- Observability ---
ENABLE_MANAGED_GRAFANA=true
ENABLE_MANAGED_PROMETHEUS=true
